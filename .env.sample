# Sample environment file for the agentbench test suite.
#
# Copy this file to `.env` and edit the values for your setup:
#
#     cp .env.sample .env
#
# `.env` is loaded automatically by agentbench/settings.py (and is
# git-ignored, so local overrides never get committed). Any variable already
# set in your real shell environment always takes priority over `.env`, and
# a `pytest --agent-url ...` / `--agent-model ...` CLI flag always takes
# priority over both.
#
# None of these are required to run the suite -- every variable has a
# built-in default (see agentbench/settings.py). Set only what you need to
# change.

# ---------------------------------------------------------------------------
# Server connection
# ---------------------------------------------------------------------------

# Base URL of the FreeToken (or other OpenAI/Anthropic-compatible) server
# under test. Default: http://localhost:8000
AGENTBENCH_URL=http://192.168.0.88:8000

# Model id to request. Must match an id the target server actually serves --
# verify with: curl $AGENTBENCH_URL/v1/models
AGENTBENCH_MODEL=qwen3.6-35b-a3b

# Per-request timeout in seconds for normal test calls. Large-context /
# slow tests can legitimately take minutes on a big model. Default: 300
AGENTBENCH_TIMEOUT=300

# Timeout in seconds for quick raw-`requests` calls that bypass
# AgentBenchClient (health checks, malformed-request checks, token
# counting). Default: 30
#AGENTBENCH_SHORT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Run-mode toggles (opt-in test categories)
# ---------------------------------------------------------------------------
# These are also available as CLI flags (--run-slow / --run-concurrency);
# a CLI flag always overrides these. Useful for CI configs that can't easily
# add pytest CLI args.

# Set to 1/true/yes/on to also run tests marked 'slow' (large-context,
# long-generation tests) without passing --run-slow explicitly.
#AGENTBENCH_RUN_SLOW=0

# Set to 1/true/yes/on to also run tests marked 'concurrency' (parallel
# requests against the live server) without passing --run-concurrency
# explicitly. This deliberately saturates the shared GPU.
#AGENTBENCH_RUN_CONCURRENCY=0

# ---------------------------------------------------------------------------
# Server capability thresholds
# ---------------------------------------------------------------------------

# Regression-guard floor for /v1/models' advertised max_model_len -- catches
# a misconfigured context-window override silently truncating it.
# Default: 32000
#AGENTBENCH_MIN_CONTEXT_TOKENS=32000

# The context window the server is expected to be configured for end to
# end; used as the target for large-context needle-retrieval tests and in
# their failure messages. Default: 262144
#AGENTBENCH_CONTEXT_WINDOW=262144

# Must match the server's actual --max-running-requests (or equivalent
# admission-control limit) for the over-capacity concurrency test to probe
# the right boundary. Default: 4
#AGENTBENCH_MAX_RUNNING_REQUESTS=4

# How many concurrent requests the over-capacity test fires. Should be
# greater than AGENTBENCH_MAX_RUNNING_REQUESTS so some requests must queue
# behind admission control. Default: 2x AGENTBENCH_MAX_RUNNING_REQUESTS
#AGENTBENCH_OVER_CAPACITY_REQUESTS=8

# ---------------------------------------------------------------------------
# Reasoning-budget-aware max_tokens defaults
# ---------------------------------------------------------------------------
# Many checkpoints default to a non-trivial ("medium") reasoning effort
# whenever a request doesn't explicitly disable thinking, and can spend
# 100-200+ tokens deliberating before emitting any visible content. If you
# point this suite at a more (or less) verbose model, raise or lower these
# rather than editing test files.

# max_tokens budget for trivial "is the protocol alive" sanity prompts.
# Default: 300
#AGENTBENCH_BASIC_MAX_TOKENS=300

# max_tokens budget for content/template-robustness tests that are not
# themselves testing reasoning-token budgets. Default: 400
#AGENTBENCH_GENEROUS_MAX_TOKENS=400

# ---------------------------------------------------------------------------
# Large-context test sizing
# ---------------------------------------------------------------------------

# Target prompt sizes (in tokens) for the needle-in-haystack large-context
# tests. Only exercised with --run-slow / AGENTBENCH_RUN_SLOW=1.
#AGENTBENCH_LARGE_CONTEXT_SMALL_TOKENS=60000
#AGENTBENCH_LARGE_CONTEXT_LARGE_TOKENS=200000

# ---------------------------------------------------------------------------
# Chat-template installation checks (test_chat_template.py)
# ---------------------------------------------------------------------------

# Path to a local chat_template.jinja file (or a model directory containing
# one) to run the offline template-version checks against. Unset by
# default -- those tests skip cleanly when this isn't provided, since the
# canonical copy typically lives on the remote server's filesystem, not this
# suite's.
#AGENTBENCH_TEMPLATE_PATH=/path/to/chat_template.jinja

# Minimum acceptable major version of the froggeric-patched chat template.
# Default: 22
#AGENTBENCH_MIN_TEMPLATE_VERSION=22
